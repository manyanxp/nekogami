# 実行時のデータ（台帳・テーマ・バックアップ。個人の構成が入る）
portal/data/

# 調査・提案の成果物（個人的な内容を含みうるのでコミットしない）
reports/
research/

# 要件の元資料（個人のメモ・参考画像。出どころ不明の画像を含むのでコミットしない）
docs/add_requirement/

# 担当が読み書きする作業領域（ディレクトリのノードの置き場。中身は利用者のデータなのでコミットしない）
workspace/*
!workspace/.gitkeep

# Python / Node
__pycache__/
*.pyc
.venv/
node_modules/
web/.next/
web/next-env.d.ts
*.tsbuildinfo

# ローカル設定・OS
.claude/settings.local.json
.env
.env.*
.DS_Store
